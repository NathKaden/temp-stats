API_KEY=your-secret-key
NEXT_PUBLIC_API_URL=
COLLECTION_INTERVAL_SECONDS=3600
POWER_BASE_W=5.0
POWER_MAX_W=15.0

# --- Backup Configuration ---
# Interval for checking if a backup is needed (in seconds, default: 3600)
BACKUP_CHECK_INTERVAL_SECONDS=3600
# Maximum age of the last backup before a new one is triggered (in seconds, default: 604800 / 7 days)
BACKUP_AGE_THRESHOLD_SECONDS=604800

# Retention limits (number of archives to keep)
MAX_BACKUPS_NEXTCLOUD=1
MAX_BACKUPS_MINECRAFT=3
MAX_BACKUPS_OUTLINE=5
